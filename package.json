{
  "name": "@modulane/dev-workspace-cli",
  "version": "0.0.0-development",
  "description": "An interactive CLI for browsing development projects and running their scripts with npm, pnpm, Yarn or Bun.",
  "type": "module",
  "bin": {
    "dev-workspace": "index.js",
    "dws": "index.js"
  },
  "files": [
    "index.js",
    "lib/"
  ],
  "scripts": {
    "start": "node index.js",
    "test": "node --test",
    "check": "npm run format:check && npm test",
    "coverage": "c8 --all --include=lib --check-coverage --lines 80 --statements 80 --reporter=text --reporter=lcov --reporter=json-summary node --test",
    "prepublishOnly": "npm run check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "cli",
    "developer-tools",
    "workspace",
    "npm-scripts",
    "project-manager",
    "terminal"
  ],
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modulane/dev-workspace-cli.git"
  },
  "homepage": "https://github.com/modulane/dev-workspace-cli#readme",
  "bugs": {
    "url": "https://github.com/modulane/dev-workspace-cli/issues"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.4",
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@yarnpkg/cli-dist": "4.18.1",
    "c8": "^12.0.0",
    "prettier": "3.9.10",
    "semantic-release": "^25.0.9"
  }
}
